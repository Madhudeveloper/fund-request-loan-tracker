{
  "info": {
    "name": "Loan Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fund Request & Loan Tracker (Laravel + Sanctum). Run \"Login: Admin\" or \"Login: Applicant (Alice)\" first: the token is saved automatically."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "loan_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (applicant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Public. Creates an applicant account and returns a token. Errors: 422 validation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Applicant\",\n  \"email\": \"new.applicant@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login: Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Seeded admin. Saves the token to {{token}}. 401 on wrong credentials.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login: Applicant (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Seeded applicant. Saves the token to {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revokes the current token."
          }
        }
      ]
    },
    {
      "name": "2. Loans",
      "item": [
        {
          "name": "List loans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "home",
                  "disabled": true
                }
              ]
            },
            "description": "Applicant: own loans. Admin: all loans. Paginated (10). Filters: status (pending|approved|rejected|closed), search (purpose)."
          }
        },
        {
          "name": "Create loan (applicant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('loan_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans"
              ]
            },
            "description": "Applicant only. Amount 10,000 to 10,00,000; tenure 6 to 60. 403 for admin, 422 on invalid input. Saves {{loan_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150000,\n  \"tenure_months\": 24,\n  \"purpose\": \"Home renovation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get loan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}"
              ]
            },
            "description": "Owner or admin. Includes repayments and documents. 403 for another user, 404 if missing."
          }
        },
        {
          "name": "Approve loan (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "status"
              ]
            },
            "description": "Admin only; allowed only while status is pending (otherwise 422).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"remarks\": \"Documents verified.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reject loan (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "status"
              ]
            },
            "description": "Admin only; allowed only while status is pending (otherwise 422).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"remarks\": \"Insufficient income proof.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Repayments",
      "item": [
        {
          "name": "Add repayment (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/repayments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "repayments"
              ]
            },
            "description": "Admin only; loan must be approved; total repaid cannot exceed the loan amount (422). Loan closes automatically when fully repaid. reference_no must be unique.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 15000,\n  \"paid_on\": \"2026-11-02\",\n  \"reference_no\": \"REF-DEMO-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Documents",
      "item": [
        {
          "name": "Upload document (owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/documents",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "documents"
              ]
            },
            "description": "Owner only. PDF only, max 5 MB. Queues the AI summary job; summary_status starts as pending (then completed or failed). Choose a PDF in the file field.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. AI Assistant",
      "item": [
        {
          "name": "Ask loan assistant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loans",
                "{{loan_id}}",
                "ask"
              ]
            },
            "description": "Owner or admin. Answers only from this loan's data. 503 with a friendly message if the LLM is unavailable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How much is still outstanding?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard",
      "item": [
        {
          "name": "Dashboard summary (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                "summary"
              ]
            },
            "description": "Admin only. Counts by status, total disbursed, total repaid, total outstanding."
          }
        }
      ]
    }
  ]
}